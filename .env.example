# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Guild ID for dev command registration (remove for global/production)
GUILD_ID=your_dev_guild_id_here

# Database path (Railway volume mount point)
DB_PATH=/data/fitness.db

# Optional: Strava API (future)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Optional: Nutritionix API for food database
# NUTRITIONIX_APP_ID=
# NUTRITIONIX_API_KEY=
